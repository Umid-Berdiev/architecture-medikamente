    <mxCell id="ish-1" value="&lt;b&gt;Диаграмма Исикавы: узкие места миграции «Медикаменте»&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
     <mxGeometry x="20" y="10" width="1600" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="ish-2" value="&lt;i&gt;Категории — кости; жирным — первичные причины; мелким — факторы. Эффект — голова рыбы. Приоритеты мер и обоснование — в README.md&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
     <mxGeometry x="20" y="42" width="1600" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="ish-3" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#333333;endSize=10;" edge="1" parent="1">
