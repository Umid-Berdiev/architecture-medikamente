    </mxCell>
    <mxCell id="ish-84" value="&lt;b&gt;Нет нагрузочного тестирования и SLO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет capacity planning под ×5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• целевые показатели не заданы&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingTop=2;" vertex="1" parent="1">
