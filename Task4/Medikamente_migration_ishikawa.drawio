      <mxPoint x="330" y="240" as="sourcePoint"/>
      <mxPoint x="560" y="760" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-6" value="Инфраструктура" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=20;" vertex="1" parent="1">
     <mxGeometry x="215.0" y="196" width="230" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="ish-7" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#B85450;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="277.1428571428571" y="685.7142857142858" as="sourcePoint"/>
      <mxPoint x="527.1428571428571" y="685.7142857142858" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-8" value="&lt;b&gt;Единственный физический сервер в офисе&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет ресурсов для параллельной работы старой и новой систем&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет горячего резерва и DR-площадки&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="277.1428571428571" y="643.7142857142858" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-9" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#B85450;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="244.28571428571428" y="611.4285714285714" as="sourcePoint"/>
      <mxPoint x="494.2857142857143" y="611.4285714285714" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-10" value="&lt;b&gt;Каналы связи офис ↔ площадка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• узкая полоса и задержка до ЦОД/облака&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• ГОСТ VPN-шлюзы ограничивают пропускную способность&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="244.28571428571428" y="569.4285714285714" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-11" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#B85450;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="211.42857142857144" y="537.1428571428571" as="sourcePoint"/>
      <mxPoint x="461.42857142857144" y="537.1428571428571" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-12" value="&lt;b&gt;Kubernetes без лимитов и автомасштабирования&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• шумные соседи, OOM-kill&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет HPA и cluster autoscaler&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="211.42857142857144" y="495.1428571428571" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-13" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#B85450;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="178.57142857142856" y="462.8571428571429" as="sourcePoint"/>
      <mxPoint x="428.57142857142856" y="462.8571428571429" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-14" value="&lt;b&gt;Дисковая подсистема&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• медленные диски под PostgreSQL и Kafka&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• шифрование томов без AES-NI, S3 на одном узле&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="178.57142857142856" y="420.8571428571429" width="246" height="42" as="geometry"/>
    </mxCell>
