    <mxCell id="ish-22" value="&lt;b&gt;Качество исходных данных Excel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• дубликаты пациентов, разные форматы ФИО и дат&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• пустые и «свободные» поля, ручная выверка&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="781.25" y="653.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-23" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#D79B00;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="752.5" y="630.0" as="sourcePoint"/>
      <mxPoint x="1002.5" y="630.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-24" value="&lt;b&gt;Объём и формат документов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• тысячи сканов и PDF «любого формата»&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• долгая загрузка в S3, OCR и классификация&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="752.5" y="588.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-25" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#D79B00;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="723.75" y="565.0" as="sourcePoint"/>
      <mxPoint x="973.75" y="565.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-26" value="&lt;b&gt;Зашифрованные поля нельзя индексировать&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• поиск по ФИО/телефону только через HMAC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• LIKE и сортировка по ПДн невозможны&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="723.75" y="523.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-27" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#D79B00;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="695.0" y="500.0" as="sourcePoint"/>
      <mxPoint x="945.0" y="500.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-28" value="&lt;b&gt;Разделение доменов Identity / Clinical&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет JOIN между сервисами → N+1 вызовов&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• агрегаты собираются из нескольких БД&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="695.0" y="458.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-29" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#D79B00;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="666.25" y="435.0" as="sourcePoint"/>
      <mxPoint x="916.25" y="435.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-30" value="&lt;b&gt;Конвертация файловых баз 1С&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• перевод в клиент-сервер, блокировки, регламентные операции&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="666.25" y="406.0" width="246" height="29" as="geometry"/>
    </mxCell>
    <mxCell id="ish-31" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#D79B00;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="637.5" y="370.0" as="sourcePoint"/>
      <mxPoint x="887.5" y="370.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-32" value="&lt;b&gt;Двойная запись во время dual-run&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• расхождения Excel ↔ БД, конфликты правок&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет эталона данных&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="637.5" y="328.0" width="246" height="42" as="geometry"/>
    </mxCell>
