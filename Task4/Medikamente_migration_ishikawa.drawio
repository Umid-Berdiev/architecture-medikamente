     <mxGeometry relative="1" as="geometry">
      <mxPoint x="145.71428571428572" y="388.57142857142856" as="sourcePoint"/>
      <mxPoint x="395.7142857142857" y="388.57142857142856" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-16" value="&lt;b&gt;Нет среды, идентичной продуктиву&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нагрузочные тесты на «уменьшенной копии»&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• сюрпризы при переключении&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="145.71428571428572" y="346.57142857142856" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-17" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#B85450;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="112.85714285714289" y="314.28571428571433" as="sourcePoint"/>
      <mxPoint x="362.8571428571429" y="314.28571428571433" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-18" value="&lt;b&gt;Резервное копирование и восстановление&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• восстановление занимает часы&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• бэкапы конкурируют за IOPS в рабочее время&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="112.85714285714289" y="272.28571428571433" width="246" height="42" as="geometry"/>
    </mxCell>
