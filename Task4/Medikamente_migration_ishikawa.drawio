      <mxPoint x="1560" y="760" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-36" value="Программное обеспечение и архитектура" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E7DAD;strokeColor=#0E7DAD;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=20;" vertex="1" parent="1">
     <mxGeometry x="1215.0" y="196" width="230" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="ish-37" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#0E7DAD;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="1281.25" y="695.0" as="sourcePoint"/>
      <mxPoint x="1531.25" y="695.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-38" value="&lt;b&gt;Распределённый монолит&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• синхронные цепочки gateway → сервис → сервис&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• каскадные таймауты, нет circuit breaker&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="1281.25" y="653.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-39" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#0E7DAD;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="1252.5" y="630.0" as="sourcePoint"/>
      <mxPoint x="1502.5" y="630.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-40" value="&lt;b&gt;«Болтливые» вызовы Identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• токенизация patient_id на каждый запрос&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет кэша и пакетных операций&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="1252.5" y="588.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-41" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#0E7DAD;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="1223.75" y="565.0" as="sourcePoint"/>
      <mxPoint x="1473.75" y="565.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-42" value="&lt;b&gt;Нет идемпотентности и backpressure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• retry storm при сбое&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• дубли платежей и уведомлений&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="1223.75" y="523.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-43" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#0E7DAD;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="1195.0" y="500.0" as="sourcePoint"/>
      <mxPoint x="1445.0" y="500.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-44" value="&lt;b&gt;Service mesh и sidecar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• задержка и CPU на mTLS в каждом поде&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• неверные таймауты mesh&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="1195.0" y="458.0" width="246" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="ish-45" value="" style="endArrow=none;html=1;strokeWidth=1;strokeColor=#0E7DAD;" edge="1" parent="1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="1166.25" y="435.0" as="sourcePoint"/>
      <mxPoint x="1416.25" y="435.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-46" value="&lt;b&gt;Kafka настроена по умолчанию&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• мало партиций, большие сообщения с документами&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• consumer lag, нет exactly-once&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="1166.25" y="393.0" width="246" height="42" as="geometry"/>
