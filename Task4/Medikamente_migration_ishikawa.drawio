      <mxPoint x="608.75" y="305.0" as="sourcePoint"/>
      <mxPoint x="858.75" y="305.0" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-34" value="&lt;b&gt;Рост данных ×5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• нет партиционирования, bloat и vacuum&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#444&quot;&gt;• журнал аудита растёт быстрее данных&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;spacing=0;spacingBottom=2;" vertex="1" parent="1">
     <mxGeometry x="608.75" y="263.0" width="246" height="42" as="geometry"/>
    </mxCell>
