      <mxPoint x="60" y="760" as="sourcePoint"/>
      <mxPoint x="2080" y="760" as="targetPoint"/>
     </mxGeometry>
    </mxCell>
    <mxCell id="ish-4" value="Деградация производительности и доступности новой платформы «Медикаменте» в ходе и после миграции с файлового ландшафта (Excel, сканы, файловые базы 1С) на микросервисную платформу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;fontSize=12;arcSize=12;" vertex="1" parent="1">
     <mxGeometry x="2090" y="690" width="300" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="ish-5" value="" style="endArrow=none;html=1;strokeWidth=2.5;strokeColor=#B85450;" edge="1" parent="1">
