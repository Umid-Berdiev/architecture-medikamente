    </mxCell>
    <mxCell id="ish-20" value="Данные и базы данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D79B00;strokeColor=#D79B00;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=20;" vertex="1" parent="1">
