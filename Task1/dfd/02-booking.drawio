    <mxCell id="as-is-35" value="&lt;b&gt;R-02&lt;/b&gt; Нет аудита: кто, когда и какие данные открыл, скопировал, изменил" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
