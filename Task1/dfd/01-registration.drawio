    <mxCell id="to-be-10" value="&lt;b&gt;D1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Реестр пациентов (PostgreSQL, домен Identity)&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;колоночное шифрование; доступ только через приложение&lt;/font&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;right=0;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
