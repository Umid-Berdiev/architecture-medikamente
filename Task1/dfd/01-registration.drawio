    </mxCell>
    <mxCell id="to-be-31" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="to-be-30" target="to-be-5">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-32" value="&lt;b&gt;C-15&lt;/b&gt; Бумага: сканирование в карту, уничтожение по регламенту, учёт архива, сейф" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
