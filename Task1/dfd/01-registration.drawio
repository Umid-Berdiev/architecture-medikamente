     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-34" value="&lt;b&gt;C-08&lt;/b&gt; DLP и каналы вывода: запрет отправки тегированных данных наружу, блокировка USB, учёт печати, запрет локальных копий (VDI)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1190" y="620" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-35" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="to-be-34" target="to-be-13">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-36" value="&lt;b&gt;C-02&lt;/b&gt; Шифрование at rest: тома (LUKS/TDE), колоночное шифрование идентификаторов, ключи в KMS/Vault, шифрованные бэкапы" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
