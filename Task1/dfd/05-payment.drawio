     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-34" value="&lt;b&gt;C-14&lt;/b&gt; 1С в клиент-серверном режиме (PostgreSQL), роли 1С, аудит, файловый доступ к базе закрыт; ККМ по защищённому каналу" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="900" y="240" width="280" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-35" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="to-be-34" target="to-be-15">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-36" value="&lt;b&gt;C-04&lt;/b&gt; Псевдонимизация: домен Identity (ФИО, паспорт, контакты) отделён от домена Clinical (диагнозы, анализы); связь через patient_id" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1240" y="60" width="200" height="66" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-37" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="to-be-36" target="to-be-6">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-38" value="&lt;b&gt;C-12&lt;/b&gt; IAM: SSO (Keycloak + AD), MFA, least privilege, роли Reception/Doctor/Cashier/Accountant/Analyst, PAM для администратора" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="620" y="60" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-39" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="to-be-38" target="to-be-14">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-40" value="&lt;b&gt;C-06&lt;/b&gt; Аудит доступа: каждое чтение/запись тегированных данных пишется в журнал → Elastic/SIEM, алерты на аномалии" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="40" y="480" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-41" value="&lt;b&gt;C-02&lt;/b&gt; Шифрование at rest: тома (LUKS/TDE), колоночное шифрование идентификаторов, ключи в KMS/Vault, шифрованные бэкапы" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="40" y="560" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-42" value="&lt;b&gt;C-03&lt;/b&gt; Шифрование in transit: TLS 1.2+ для всех соединений, mTLS между сервисами, S/MIME или защищённый портал для почты" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1240" y="500" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-43" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="to-be-42" target="to-be-5">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-44" value="&lt;b&gt;Нотация (Gane-Sarson)&lt;/b&gt;&lt;br&gt;Серый прямоугольник — внешняя сущность (человек/организация), пунктирный — внешняя система.&lt;br&gt;Скруглённый голубой блок — процесс (номер, название, исполнитель).&lt;br&gt;Жёлтый открытый блок — хранилище данных (D-номер); оранжевый пунктирный — неучтённое («теневое») хранилище.&lt;br&gt;Стрелка — поток данных; пунктирная — ручной/бумажный/голосовой канал.&lt;br&gt;Красная заметка R-xx — проблемная зона (см. 02-security-audit.md); зелёная C-xx — мера защиты (см. 05-controls.md)." style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
     <mxGeometry x="20" y="760" width="620" height="90" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>
</mxfile>
