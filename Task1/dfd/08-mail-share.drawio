    </mxCell>
    <mxCell id="as-is-33" value="&lt;b&gt;R-01&lt;/b&gt; ПДн и мед. сведения в Excel/сканах на общем диске; доступ ограничен только доменной учёткой" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1240" y="440" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-34" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="as-is-33" target="as-is-15">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-35" value="&lt;b&gt;R-20&lt;/b&gt; Нет контроля вывода: печать, USB, личные устройства, внешняя почта" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1240" y="540" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-36" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="as-is-35" target="as-is-16">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-37" value="&lt;b&gt;R-12&lt;/b&gt; Один администратор «может всё», нет MFA и разделения привилегий, нет PAM" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="40" y="480" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-38" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="as-is-37" target="as-is-7">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-39" value="&lt;b&gt;R-08&lt;/b&gt; Нет шифрования at rest: файлы, базы 1С, почтовые ящики; бэкапы не формализованы" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1240" y="660" width="200" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-40" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="as-is-39" target="as-is-17">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-41" value="&lt;b&gt;R-18&lt;/b&gt; Единая физическая площадка: AD, файлы, почта, 1С на одном сервере в офисе; нет DR" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="300" y="580" width="240" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-42" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;dashPattern=1 2;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1" source="as-is-41" target="as-is-13">
     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-43" value="&lt;b&gt;R-02&lt;/b&gt; Нет аудита: кто, когда и какие данные открыл, скопировал, изменил" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="300" y="60" width="240" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="as-is-44" value="&lt;b&gt;Нотация (Gane-Sarson)&lt;/b&gt;&lt;br&gt;Серый прямоугольник — внешняя сущность (человек/организация), пунктирный — внешняя система.&lt;br&gt;Скруглённый голубой блок — процесс (номер, название, исполнитель).&lt;br&gt;Жёлтый открытый блок — хранилище данных (D-номер); оранжевый пунктирный — неучтённое («теневое») хранилище.&lt;br&gt;Стрелка — поток данных; пунктирная — ручной/бумажный/голосовой канал.&lt;br&gt;Красная заметка R-xx — проблемная зона (см. 02-security-audit.md); зелёная C-xx — мера защиты (см. 05-controls.md)." style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
     <mxGeometry x="20" y="780" width="620" height="90" as="geometry"/>
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>
