     <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="to-be-35" value="&lt;b&gt;C-13&lt;/b&gt; Сегментация сети: отдельный сегмент ИСПДн, БД и файлы недоступны из пользовательских VLAN напрямую, МЭ/СКЗИ по ФСТЭК" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
