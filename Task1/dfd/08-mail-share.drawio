    <mxCell id="to-be-3" value="Физический сервер в офисе: AD, DNS, DHCP, файловый сервер, Exchange → сегмент ИСПДн, DMZ для почты, PAM" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=2;fontColor=#9673A6;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1">
