    <mxCell id="as-is-31" value="&lt;b&gt;R-05&lt;/b&gt; Передача ПДн и мед. данных по открытым каналам: e-mail без шифрования, телефон, бумага" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
     <mxGeometry x="1240" y="60" width="200" height="58" as="geometry"/>
    </mxCell>
