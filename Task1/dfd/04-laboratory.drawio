    <mxCell id="to-be-41" value="&lt;b&gt;C-15&lt;/b&gt; Бумага: сканирование в карту, уничтожение по регламенту, учёт архива, сейф" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=9;align=left;spacingLeft=4;spacingTop=2;size=10;verticalAlign=top;" vertex="1" parent="1">
