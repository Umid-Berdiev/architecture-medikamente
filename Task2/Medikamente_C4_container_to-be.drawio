    <mxCell id="container-1" value="&lt;b&gt;TO-BE: Диаграмма контейнеров C4 — Платформа «Медикаменте», платформа приватности и аналитический слой&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
     <mxGeometry x="20" y="10" width="2000" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="container-2" value="&lt;i&gt;Целевое состояние. Зелёные контейнеры — новые блоки Privacy by Design, которые обслуживают все доменные сервисы; фиолетовые — аналитический слой, работающий только с псевдонимизированными и обезличенными данными.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
     <mxGeometry x="20" y="42" width="2000" height="20" as="geometry"/>
    </mxCell>
